@page "/run/details/{runDateString}"
@using PaceMate.Objects
@using System.Text.Json
@inject IJSRuntime JSRuntime

<main>
    <div id="largeMap" class="map"></div>
    <p>@savedRun.Distance @savedRun.DistanceUnit</p>
    <p>@savedRun.AvgSpeed @savedRun.SpeedUnit</p>
</main>

@code {
    [Parameter]
    public string runDateString { get; set; } = "";

    private SavedRun savedRun = new SavedRun();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var jsonString = await JSRuntime.InvokeAsync<string>("getSavedRunByDate", runDateString);
            savedRun = JsonSerializer.Deserialize<SavedRun>(jsonString)!;

            var latitude = $"{savedRun.Path[0].Latitude}";
            var longitude = $"{savedRun.Path[0].Longitude}";
            await JSRuntime.InvokeVoidAsync("initializeMap", "largeMap", latitude, longitude);

            var pathJSONString = JsonSerializer.Serialize(savedRun.Path);
            await JSRuntime.InvokeVoidAsync("fitAndDrawPathOnMap", "largeMap", pathJSONString);
            StateHasChanged();
        }
    }
}