@page "/run/details/{runDateString}"
@using PaceMate.Objects
@using System.Text.Json
@inject IJSRuntime JSRuntime

<main>
    <div id="largeMap"></div>
    <p>@savedRunObject.Distance @savedRunObject.DistanceUnit</p>
    <p>@savedRunObject.AvgSpeed @savedRunObject.SpeedUnit</p>
</main>

@code {
    [Parameter]
    public string runDateString { get; set; } = "";

    private SavedRun savedRunObject = new SavedRun();
    protected override async Task OnInitializedAsync()
    {
        var jsonString = await JSRuntime.InvokeAsync<string>("getSavedRunByDate", runDateString);
        savedRunObject = JsonSerializer.Deserialize<SavedRun>(jsonString)!;
        StateHasChanged();
    }
}