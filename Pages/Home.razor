@page "/"
@using PaceMate.Components

<PageTitle>Home</PageTitle>

@if (runType is not "") {
    <DialogBox>
        <p>@runType</p>
    </DialogBox>
}

<button @onclick="runForDistance" class="btn-primary">Run for Distance</button>
<button @onclick="runForTime" class="btn-primary">Run for Time</button>

@code {
    private string runType = "";
    private void runForDistance() {
        runType = "distance";
    }
    private void runForTime() {
        runType = "time";
    }
}