@using System.Text.Json.Nodes
@using PaceMate.Objects
@using System.Globalization
@using System.Timers
@using System.Text.Json

@inject NavigationManager Navigation
@inject GoalState goalState
@inject IJSRuntime JSRuntime

<main>
    <div id="map"></div>
    <div class="info-container">
        <div class="timer-container">
            <p class="timer-large">@(time[0] != "00" ? $"{time[0]} : " : "")</p>
            <p class="timer-large">@(time[1] != "00" ? $"{time[1]} : " : "")</p>
            <p class="timer-large">@time[2]</p>
            <p class="timer-small">@time[3]</p>
        </div>  
        <div class="horizontal-container">
            <p>@parseDistanceLabel()</p>    
            <p>@($"{speedKMH:F2}") km/h</p>
        </div>
        @if (goalState.distanceGoal is not null) {
            <span>Goal Progress</span>
            <div class="progress-bar-container">
                <div style="width: @goalState.untilGoalReachedPercent()%;" class="progress-bar"></div>  
                <div>
                    <p>@goalState.untilGoalReachedPercent()%</p>      
                    <p>@goalState.untilGoalReachedLabel()</p>      
                </div>
            </div>
        }
    </div>

    @if (goalState.isGoalReached()) {
        <button class="primary stick-to-bottom fill-btn" @onclick="SaveRun">SAVE RUN</button>
    }
    else if (countDown_Count > 0 && trackingLocation) {
        <button class="count-down stick-to-bottom fill-btn">@countDown_Count</button>
    }
    else if (trackingLocation)
    {
        <button class="stop stick-to-bottom fill-btn" @onclick="StopTracking">STOP</button>
    }
    else    
    {
        <button class="start stick-to-bottom fill-btn" @onclick="StartTracking">START</button>
    }
</main>

@code {
    private double latitude = 0.0;
    private double longitude = 0.0;
    private bool trackingLocation = false;
    private System.Timers.Timer timer;
    private System.Timers.Timer countDownTimer;
    private int timePastInSeconds = 0;
    private DateTime lastSignalTime;
    private TimeSpan elapsedTime;
    private string[] time = { "00", "00", "00", "0" };
    private double distanceInKM = 0.0;
    private double speedKMH = 0.0;  
    private Coordinates[] lastTwoCoordinates = new Coordinates[2];
    private List<Coordinates> path = new List<Coordinates>();

    protected override void OnInitialized()
    {   
        if(goalState.distanceGoal is null) {
            Navigation.NavigateTo("/");
        }
        elapsedTime = TimeSpan.Zero;
        countDownTimer = new System.Timers.Timer(1000);
        countDownTimer.Elapsed += (_, _) => countDown();
        timer = new System.Timers.Timer(100);
        timer.Elapsed += TrackLiveLocation;
    }

    public int countDown_Count = 3;
    private async void countDown() {
        countDown_Count -= 1;
        StateHasChanged();

        if(countDown_Count == 0) {
            await getLocation();
            lastTwoCoordinates[0] = new Coordinates { Latitude = latitude, Longitude = longitude };
            lastTwoCoordinates[1] = new Coordinates { Latitude = latitude, Longitude = longitude };
            countDownTimer.Stop();
            lastSignalTime = DateTime.Now;
            timer.Start();
        }
    }
    private async void SaveRun() {
        goalState.resetState();
        SavedRun saveDataObject = new SavedRun {
            path = path,
            avgSpeed = speedKMH,
            speedUnit = "KM/H",
            distance = distanceInKM,
            distanceUnit = "KM",
            time = time
        };

        string jsonSaveData = JsonSerializer.Serialize(saveDataObject);
        Console.WriteLine(jsonSaveData);
        await JSRuntime.InvokeVoidAsync("saveRun", jsonSaveData);
        Navigation.NavigateTo("/");
    }
    private string[] FormatElapsedTime(TimeSpan timeSpan)
    {
        var hours = string.Format("{0:D2}", timeSpan.Hours);
        var minutes = string.Format("{0:D2}", timeSpan.Minutes);
        var seconds = string.Format("{0:D2}", timeSpan.Seconds);
        var milliSeconds = string.Format("{0:D2}", timeSpan.Milliseconds);

        hours = hours.Length < 2 ? $"0{hours}" : hours;
        minutes = minutes.Length < 2 ? $"0{minutes}" : minutes;
        seconds = seconds.Length < 2 ? $"0{seconds}" : seconds;

        milliSeconds = milliSeconds.Length > 0 ? milliSeconds.Substring(0, 1) : milliSeconds;

        return [hours, minutes, seconds, milliSeconds];
    }
    private async void TrackLiveLocation(object? _, ElapsedEventArgs e)
    {
        TimeSpan currentElapsedTimeChange = DateTime.Now - lastSignalTime;
        time = FormatElapsedTime(elapsedTime);
        elapsedTime += currentElapsedTimeChange;
        lastSignalTime = DateTime.Now;

        await getLocation();
        await moveLocationMarker();

        //Adding the coordinates to the list
        lastTwoCoordinates[0] = lastTwoCoordinates[1];
        lastTwoCoordinates[1] = new Coordinates { Latitude = latitude, Longitude = longitude };
        
        //Add coordinate to the path
        path.Add(lastTwoCoordinates[1]);

        //Calculate distance delta
        var lastDistanceChange = calculateDistanceOfLastTwoPointsInKM();
        distanceInKM += lastDistanceChange;

        //Updated distance goal state
        goalState.distanceTraveled = distanceInKM;

        if(goalState.isGoalReached()) {
            calculateTheSpeed(elapsedTime);
            StopTracking();
        }

        //Calculate and update speed
        if(elapsedTime.Seconds % 1 == 0) {
            calculateTheSpeed(elapsedTime);
        }

        //Update user position
        await drawLine();
        StateHasChanged();
    }
    private void calculateTheSpeed(TimeSpan elapsedTime) {
        double timeInSeconds = elapsedTime.Hours * 60 + elapsedTime.Minutes * 60 + elapsedTime.Seconds + (elapsedTime.Milliseconds / 1000.0);
        speedKMH = ((distanceInKM * 1000) / timeInSeconds) * 3.6;
    }
    private string parseDistanceLabel() {
        var distance = distanceInKM.ToString("0.###");
        if(distanceInKM < 1) {
            var distanceInMeters = (int)((distanceInKM - Math.Truncate(distanceInKM)) * 1000);
            return $"{distanceInMeters}m";
        } else {
            return $"{distance}km";
        }
    }
    private Double calculateDistanceOfLastTwoPointsInKM() {
        double R = 6371.2; // Radius of the Earth in kilometers
        double lat1 = lastTwoCoordinates[0].Latitude;
        double lon1 = lastTwoCoordinates[0].Longitude;
        double lat2 = lastTwoCoordinates[1].Latitude;
        double lon2 = lastTwoCoordinates[1].Longitude;

        // Convert degrees to radians
        lat1 = lat1 * (Math.PI / 180);
        lat2 = lat2 * (Math.PI / 180);
        lon1 = lon1 * (Math.PI / 180);
        lon2 = lon2 * (Math.PI / 180);

        double dLat = (lat2 - lat1);
        double dLon = (lon2 - lon1);

        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(lat1) * Math.Cos(lat2) *
                Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        double c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));

        double distanceInKM = R * c;
        return distanceInKM;
    }

    private async Task StartTracking()
    {
        countDown_Count = 3;
        trackingLocation = true;
        countDownTimer.Start();
        StateHasChanged();
    }
    private void StopTracking()
    {
        trackingLocation = false;
        timer?.Stop();
    }
    public void Dispose()
    {
        timer?.Dispose();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await getLocation();
            await moveLocationMarker();
            await InitializeMap();
        }
    }

    private async Task getLocation()
    {
        try
        {
            var coordinates = await JSRuntime.InvokeAsync<Coordinates>("getCurrentLocation");
            latitude = coordinates.Latitude;
            longitude = coordinates.Longitude;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error retrieving location: {ex.Message}");
        }
    }
    private async Task drawLine() {
        await JSRuntime.InvokeAsync<Coordinates>(
            "drawLine",
            lastTwoCoordinates[0].Latitude,
            lastTwoCoordinates[0].Longitude,
            lastTwoCoordinates[1].Latitude,
            lastTwoCoordinates[1].Longitude
        );
    }
    private async Task moveLocationMarker()
    {
        await JSRuntime.InvokeAsync<Coordinates>("moveLocationMarker", latitude, longitude);
    }

    private async Task InitializeMap()
    {
        await JSRuntime.InvokeVoidAsync("initializeMap", latitude, longitude);
    }
}