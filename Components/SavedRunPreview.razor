@using PaceMate.Objects
@using System.Globalization
@using System.Runtime.InteropServices
@using System.Reflection.Emit
@using System.Text.Json
@inject IJSRuntime JSRuntime

<a href="/run/details/@(Date)">
    <div id="@Date" class="map"></div>
    <div class="content">
        <p>@convertStringToDateTime()</p>
        <div class="horizontal-container">
            <p>@parseDistanceLabel()</p>
            <p>@parseSpeedLabel()</p>
        </div>
        <p>@parseTimeLabel()</p>
    </div>
</a>

@code {
    [Parameter]
    public string Date { get; set; } = "";
    [Parameter]
    public SavedRun savedRun { get; set; } = new SavedRun();
    private string convertStringToDateTime()
    {
        DateTime dateTime = DateTime.Parse(Date, null, System.Globalization.DateTimeStyles.RoundtripKind);

        var day = dateNumEnding(dateTime.Day);
        var month = numToMonthName(dateTime.Month);
        var date = $"{month} {day}, {dateTime.Year}";

        return $"{date} @ {dateTime.Hour}:{dateTime.Minute}";
    }
    private string dateNumEnding(int dayOfMonth)
    {
        switch (dayOfMonth)
        {
            case 1:
            case 21:
            case 31:
                return $"{dayOfMonth}st";
            case 2:
            case 22:
                return $"{dayOfMonth}nd";
            case 3:
            case 23:
                return $"{dayOfMonth}rd";
            default:
                return $"{dayOfMonth}th";
        }
    }
    private string numToMonthName(int monthNumber)
    {
        switch (monthNumber)
        {
            case 1:
                return "January";
            case 2:
                return "February";
            case 3:
                return "March";
            case 4:
                return "April";
            case 5:
                return "May";
            case 6:
                return "June";
            case 7:
                return "July";
            case 8:
                return "August";
            case 9:
                return "September";
            case 10:
                return "October";
            case 11:
                return "November";
            case 12:
                return "December";
            default:
                throw new ArgumentOutOfRangeException("monthNumber", "Month number must be between 1 and 12.");
        }
    }
    private string parseDistanceLabel()
    {
        var label = "";
        if (savedRun.Distance < 1)
        {
            var distanceInMeters = savedRun.Distance * 1000;
            label = $"{distanceInMeters:F0}m";
        }
        else
        {
            label = $"{savedRun.Distance:F2}km";
        }
        return label;
    }
    private string parseSpeedLabel()
    {
        return $"{savedRun.AvgSpeed:F2} {savedRun.SpeedUnit.ToLower()}";
    }
    private string parseTimeLabel()
    {
        var timeParts = savedRun.Time;
        var hour = timeParts[0] != "00" ? $"{timeParts[0]}hr" : "";
        var minute = timeParts[1] != "00" ? $"{timeParts[1]}min" : "";
        var second = timeParts[2] != "00" ? $"{timeParts[2]}sec" : "";

        return $"{hour}{minute}{second} {timeParts[3]}ms";
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //Initialize the map
            var latitude = $"{savedRun.Path[0].Latitude}";
            var longitude = $"{savedRun.Path[0].Longitude}";
            await JSRuntime.InvokeVoidAsync("initializeMap", Date, latitude, longitude, false);

            var pathJSONString = JsonSerializer.Serialize(savedRun.Path);
            await JSRuntime.InvokeVoidAsync("fitAndDrawPathOnMap", Date, pathJSONString);
        }
    }
}