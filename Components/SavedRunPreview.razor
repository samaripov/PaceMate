@using PaceMate.Objects
@using System.Globalization
@using System.Runtime.InteropServices
@using System.Reflection.Emit
@inject IJSRuntime JSRuntime

<main>
    <div id="@Date" class="map"></div>
    <div class="content">
        <p>@convertStringToDateTime()</p>
        <p>@parseDistanceLabel()</p>
    </div>
</main>

@code {
    [Parameter]
    public string Date { get; set; } = "";
    [Parameter]
    public SavedRun savedRun { get; set; } = new SavedRun();
    private string convertStringToDateTime()
    {
        DateTime dateTime = DateTime.Parse(Date, null, System.Globalization.DateTimeStyles.RoundtripKind);

        var day = dateNumEnding(dateTime.Day);
        var month = numToMonthName(dateTime.Month);
        var date = $"{month} {day}, {dateTime.Year}";

        return $"{date} @ {dateTime.Hour}:{dateTime.Minute}";
    }
    private string dateNumEnding(int dayOfMonth)
    {
        switch (dayOfMonth)
        {
            case 1:
            case 21:
            case 31:
                return $"{dayOfMonth}st";
            case 2:
            case 22:
                return $"{dayOfMonth}nd";
            case 3:
            case 23:
                return $"{dayOfMonth}rd";
            default:
                return $"{dayOfMonth}th";
        }
    }
    private string numToMonthName(int monthNumber)
    {
        switch (monthNumber)
        {
            case 1:
                return "January";
            case 2:
                return "February";
            case 3:
                return "March";
            case 4:
                return "April";
            case 5:
                return "May";
            case 6:
                return "June";
            case 7:
                return "July";
            case 8:
                return "August";
            case 9:
                return "September";
            case 10:
                return "October";
            case 11:
                return "November";
            case 12:
                return "December";
            default:
                throw new ArgumentOutOfRangeException("monthNumber", "Month number must be between 1 and 12.");
        }
    }
    private string parseDistanceLabel()
    {
        var label = "";
        if (savedRun.Distance < 1)
        {
            var distanceInMeters = savedRun.Distance * 1000;
            label = $"{distanceInMeters:F0}m";
        }
        else
        {
            label = $"{savedRun.Distance:F2}km";
        }
        return label;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //Initialize the map
            var initialLatitudeString = $"{savedRun.Path[0].Latitude}";
            var initialLongitudeString = $"{savedRun.Path[0].Longitude}";
            await InitializeMap(Date, initialLatitudeString, initialLongitudeString);


            //Draw the path on the map
            var lineStartLatitude = "";
            var lineStartLongitude = "";
            foreach (Coordinates pathCoords in savedRun.Path)
            {
                if (lineStartLatitude != "" && lineStartLongitude != "")
                {
                    await JSRuntime.InvokeAsync<Coordinates>(
                    "drawLine",
                    Date,
                    lineStartLatitude,
                    lineStartLongitude,
                    pathCoords.Latitude,
                    pathCoords.Longitude
                    );
                }
                lineStartLatitude = $"{pathCoords.Latitude}";
                lineStartLongitude = $"{pathCoords.Longitude}";
            }
        }
    }
    private async Task InitializeMap(string mapId, string latitude, string longitude)
    {
        await JSRuntime.InvokeVoidAsync("initializeMap", mapId, latitude, longitude, false);
    }
}